# Runtime only. Never include credentials in frontend or build settings.
OPENGEO_PORT=4318
OPENGEO_DATA_DIR=.local
# Compose publishes OPENGEO_PORT and the sign-in callback port, and passes both to
# the container. Docker needs a fixed callback port because the browser has to
# reach it, so Compose defaults it to 4319. Left unset outside Docker, the
# callback takes an ephemeral port.
# OPENGEO_OAUTH_PORT=4319
# Docker requires a generated encryption secret, provided through a mounted file.
# OPENGEO_SECRET_FILE=/run/secrets/opengeo_secret
